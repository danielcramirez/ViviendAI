# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas .env a GitHub.

# Telegram / BotFather
TELEGRAM_BOT_TOKEN=REEMPLAZAR
TELEGRAM_BOT_USERNAME=REEMPLAZAR
TELEGRAM_WEBHOOK_SECRET=REEMPLAZAR_CON_CADENA_ALEATORIA
MAKE_STREAMLIT_WEBHOOK_URL=https://hook.us2.make.com/REEMPLAZAR
# Opcional: configura API Key authentication en el Custom Webhook de Make.
MAKE_WEBHOOK_API_KEY=REEMPLAZAR_O_DEJAR_VACIO
VIVI_AGENT_API_KEY=REEMPLAZAR_CON_CADENA_ALEATORIA
VIVI_AGENT_API_URL=http://127.0.0.1:8000/v1/chat
VIVI_AGENT_HOST=127.0.0.1
VIVI_AGENT_PORT=8000

# Gemini / Google AI Studio
GEMINI_API_KEY=REEMPLAZAR
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase
# sqlite: solo almacenamiento local. supabase: nube principal + respaldo SQLite.
DATA_BACKEND=sqlite
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
# Solo backend / almacén de secretos de Make. Nunca frontend ni GitHub.
SUPABASE_SECRET_KEY=REEMPLAZAR
SUPABASE_JWKS_URL=https://TU_PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Make
MAKE_PROFILE_WEBHOOK_URL=https://hook.make.com/REEMPLAZAR

# Aplicación
APP_BASE_URL=https://TU_DOMINIO_PUBLICO
DATA_RETENTION_DAYS=90
ENVIRONMENT=development
